[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":{\"backticks\":true,\"closingQuotes\":{\"double\":\"”\",\"single\":\"’\"},\"dashes\":true,\"ellipses\":true,\"openingQuotes\":{\"double\":\"“\",\"single\":\"‘\"},\"quotes\":true}},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"csp\":false,\"actionBodySizeLimit\":1048576,\"serverIslandBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"prerenderConflictBehavior\":\"warn\",\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"chromeDevtoolsWorkspace\":false,\"svgo\":false,\"rustCompiler\":false,\"queuedRendering\":{\"enabled\":false}},\"legacy\":{\"collectionsBackwardsCompat\":false}}","astro-version","6.1.1","content-config-digest","39d892fe00d76656","notes",["Map",11,12],"astro-content-collections-guide",{"id":11,"data":13,"body":24,"filePath":25,"digest":26,"rendered":27},{"title":14,"description":15,"tags":16,"date":20,"draft":21,"cover":22,"readingTime":23},"Astro 内容集合完全指南","深入了解 Astro 的 Content Collections API，如何定义 schema、查询内容，以及最佳实践。",[17,18,19],"Astro","Web开发","前端",["Date","2026-04-26T00:00:00.000Z"],false,"https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=1200",8,"# Astro 内容集合完全指南\n\nAstro 的 Content Collections API 是一个强大的功能，帮助你管理网站内容。本文将详细介绍如何使用这一功能。\n\n## 为什么使用 Content Collections？\n\nContent Collections 提供了：\n\n- **类型安全** - 基于 Zod schema 的类型检查\n- **自动验证** - 构建时验证内容\n- **更好的 DX** - 智能提示和自动补全\n\n## 定义 Schema\n\n首先，在 `src/content/config.ts` 中定义你的集合：\n\n```typescript\nimport { z, defineCollection } from 'astro:content';\n\nconst blogCollection = defineCollection({\n  type: 'content',\n  schema: z.object({\n    title: z.string(),\n    date: z.date(),\n    tags: z.array(z.string()),\n  }),\n});\n```\n\n## 查询内容\n\n使用 `getCollection` 和 `getEntry` 函数：\n\n```typescript\nimport { getCollection } from 'astro:content';\n\nconst posts = await getCollection('blog');\n```\n\n## 总结\n\nContent Collections 是 Astro 最强大的功能之一，值得深入学习。","src/content/notes/astro-content-collections-guide.md","60ca138a2cfd7fc7",{"html":28,"metadata":29},"\u003Ch1 id=\"astro-内容集合完全指南\">Astro 内容集合完全指南\u003C/h1>\n\u003Cp>Astro 的 Content Collections API 是一个强大的功能，帮助你管理网站内容。本文将详细介绍如何使用这一功能。\u003C/p>\n\u003Ch2 id=\"为什么使用-content-collections\">为什么使用 Content Collections？\u003C/h2>\n\u003Cp>Content Collections 提供了：\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>类型安全\u003C/strong> - 基于 Zod schema 的类型检查\u003C/li>\n\u003Cli>\u003Cstrong>自动验证\u003C/strong> - 构建时验证内容\u003C/li>\n\u003Cli>\u003Cstrong>更好的 DX\u003C/strong> - 智能提示和自动补全\u003C/li>\n\u003C/ul>\n\u003Ch2 id=\"定义-schema\">定义 Schema\u003C/h2>\n\u003Cp>首先，在 \u003Ccode>src/content/config.ts\u003C/code> 中定义你的集合：\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"typescript\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">import\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> { z, defineCollection } \u003C/span>\u003Cspan style=\"color:#F97583\">from\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> 'astro:content'\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">const\u003C/span>\u003Cspan style=\"color:#79B8FF\"> blogCollection\u003C/span>\u003Cspan style=\"color:#F97583\"> =\u003C/span>\u003Cspan style=\"color:#B392F0\"> defineCollection\u003C/span>\u003Cspan style=\"color:#E1E4E8\">({\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  type: \u003C/span>\u003Cspan style=\"color:#9ECBFF\">'content'\u003C/span>\u003Cspan style=\"color:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  schema: z.\u003C/span>\u003Cspan style=\"color:#B392F0\">object\u003C/span>\u003Cspan style=\"color:#E1E4E8\">({\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">    title: z.\u003C/span>\u003Cspan style=\"color:#B392F0\">string\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">    date: z.\u003C/span>\u003Cspan style=\"color:#B392F0\">date\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">    tags: z.\u003C/span>\u003Cspan style=\"color:#B392F0\">array\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(z.\u003C/span>\u003Cspan style=\"color:#B392F0\">string\u003C/span>\u003Cspan style=\"color:#E1E4E8\">()),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  }),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">});\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"查询内容\">查询内容\u003C/h2>\n\u003Cp>使用 \u003Ccode>getCollection\u003C/code> 和 \u003Ccode>getEntry\u003C/code> 函数：\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"typescript\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">import\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> { getCollection } \u003C/span>\u003Cspan style=\"color:#F97583\">from\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> 'astro:content'\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">const\u003C/span>\u003Cspan style=\"color:#79B8FF\"> posts\u003C/span>\u003Cspan style=\"color:#F97583\"> =\u003C/span>\u003Cspan style=\"color:#F97583\"> await\u003C/span>\u003Cspan style=\"color:#B392F0\"> getCollection\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(\u003C/span>\u003Cspan style=\"color:#9ECBFF\">'blog'\u003C/span>\u003Cspan style=\"color:#E1E4E8\">);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"总结\">总结\u003C/h2>\n\u003Cp>Content Collections 是 Astro 最强大的功能之一，值得深入学习。\u003C/p>",{"headings":30,"localImagePaths":45,"remoteImagePaths":46,"frontmatter":47,"imagePaths":49},[31,34,38,41,43],{"depth":32,"slug":33,"text":14},1,"astro-内容集合完全指南",{"depth":35,"slug":36,"text":37},2,"为什么使用-content-collections","为什么使用 Content Collections？",{"depth":35,"slug":39,"text":40},"定义-schema","定义 Schema",{"depth":35,"slug":42,"text":42},"查询内容",{"depth":35,"slug":44,"text":44},"总结",[],[],{"title":14,"description":15,"tags":48,"date":20,"cover":22,"readingTime":23},[17,18,19],[]]