---
const navItems = [
  { href: '/discovery', label: '探索', en: 'Explore' },
  { href: '/notes', label: '笔记', en: 'Notes' },
  { href: '/collections', label: '专辑', en: 'Collections' },
  { href: '/upload', label: '上传', en: 'Upload' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isNavActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a class="text-xl font-display font-bold tracking-tight" href="/">
      GLOBAL FRAME
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium tracking-wide">
      {navItems.map(item => (
        <a 
          class:list={[
            "relative group transition-colors",
            { "text-blue-500 dark:text-blue-400": isNavActive(item.href) }
          ]} 
          href={item.href}
        >
          {item.label}
          <span class:list={[
            "absolute -bottom-1 left-0 w-full h-0.5 bg-blue-500 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left",
            { "scale-x-100": isNavActive(item.href) }
          ]}></span>
        </a>
      ))}
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- Search Button -->
      <button
        id="open-search-btn"
        class="p-2 rounded-full transition-colors hover:bg-black/5 dark:hover:bg-white/10"
        aria-label="Search"
      >
        <span class="material-symbols-outlined text-xl">search</span>
      </button>
      
      <!-- Theme: explicit light / dark (separate targets) -->
      <div
        class="flex items-center gap-0.5 rounded-full border border-default bg-black/[0.03] p-0.5 dark:bg-white/[0.06]"
        role="group"
        aria-label="颜色主题"
      >
        <button
          type="button"
          id="theme-btn-light"
          class="theme-segment rounded-full p-2 transition-all duration-300 hover:bg-black/5 dark:hover:bg-white/10"
          aria-label="切换到浅色模式"
          aria-pressed="false"
          data-theme-choice="light"
        >
          <span class="material-symbols-outlined text-xl leading-none">light_mode</span>
        </button>
        <button
          type="button"
          id="theme-btn-dark"
          class="theme-segment rounded-full p-2 transition-all duration-300 hover:bg-black/5 dark:hover:bg-white/10"
          aria-label="切换到深色模式"
          aria-pressed="false"
          data-theme-choice="dark"
        >
          <span class="material-symbols-outlined text-xl leading-none">dark_mode</span>
        </button>
      </div>

      <!-- Upload CTA (Desktop) -->
      <a href="/upload" class="hidden md:inline-flex">
        <button class="bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-full text-sm font-medium transition-colors">
          加入社区
        </button>
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 hover:bg-white/10 rounded-full transition-colors"
        onclick="toggleMobileMenu()"
        aria-label="Toggle menu"
      >
        <span class="material-symbols-outlined text-xl menu-icon">menu</span>
        <span class="material-symbols-outlined text-xl close-icon hidden">close</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 backdrop-blur-lg border-b border-default"
    style="background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);"
  >
    <div class="px-6 py-4 space-y-3">
      {navItems.map(item => (
        <a 
          class:list={[
            "block py-3 px-4 rounded-xl transition-colors",
            { 
              "bg-blue-500/20 text-blue-400": isNavActive(item.href),
              "hover:bg-white/5": !isNavActive(item.href)
            }
          ]} 
          href={item.href}
        >
          <span class="font-medium">{item.label}</span>
          <span class="text-xs text-white/40 ml-2">{item.en}</span>
        </a>
      ))}
      <a href="/upload" class="block mt-4">
        <button class="w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-full text-sm font-medium transition-colors">
          加入社区
        </button>
      </a>
    </div>
  </div>
</nav>

<div
  id="global-search-modal"
  class="fixed inset-0 z-[70] hidden overflow-y-auto bg-black/50 px-4 py-10 sm:py-12"
  role="dialog"
  aria-modal="true"
  aria-labelledby="global-search-title"
>
  <div
    class="my-auto w-full max-w-2xl min-w-0 shrink-0 rounded-3xl border border-default bg-surface p-5 shadow-2xl md:p-6"
  >
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <p id="global-search-title" class="text-base font-semibold">全局搜索</p>
        <p class="mt-1 text-xs leading-relaxed text-secondary">
          输入关键词并回车，快速跳转到笔记列表检索。
        </p>
      </div>
      <button
        id="close-search-btn"
        class="shrink-0 rounded-full p-2 transition-colors hover:bg-black/5 dark:hover:bg-white/10"
        aria-label="关闭搜索"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <form id="global-search-form" class="mt-4 flex min-w-0 flex-col gap-3 sm:flex-row sm:items-stretch">
      <input
        id="global-search-input"
        class="min-h-[44px] min-w-0 flex-1 rounded-2xl border border-default bg-transparent px-4 py-3 text-sm outline-none transition focus:border-blue-400"
        type="search"
        placeholder="例如：构图 / 镜头 / 日常"
        autocomplete="off"
      />
      <button
        class="min-h-[44px] shrink-0 rounded-2xl bg-blue-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-blue-600 sm:px-8"
        type="submit"
      >
        搜索
      </button>
    </form>

    <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
      <a
        class="block rounded-2xl border border-default px-4 py-3 text-center text-sm transition hover:border-blue-400 hover:text-blue-500"
        href="/discovery"
        >前往探索页</a
      >
      <a
        class="block rounded-2xl border border-default px-4 py-3 text-center text-sm transition hover:border-blue-400 hover:text-blue-500"
        href="/upload"
        >前往上传页</a
      >
      <a
        class="block rounded-2xl border border-default px-4 py-3 text-center text-sm transition hover:border-blue-400 hover:text-blue-500"
        href="/notes"
        >前往笔记页</a
      >
    </div>
  </div>
</div>

<script is:inline>
  function syncThemeSegments() {
    const isDark = document.documentElement.classList.contains('dark');
    const lightBtn = document.getElementById('theme-btn-light');
    const darkBtn = document.getElementById('theme-btn-dark');
    if (lightBtn) {
      lightBtn.setAttribute('aria-pressed', (!isDark).toString());
      lightBtn.classList.toggle('bg-blue-500/20', !isDark);
      lightBtn.classList.toggle('text-blue-600', !isDark);
      lightBtn.classList.toggle('dark:text-blue-400', !isDark);
    }
    if (darkBtn) {
      darkBtn.setAttribute('aria-pressed', isDark.toString());
      darkBtn.classList.toggle('bg-blue-500/20', isDark);
      darkBtn.classList.toggle('text-blue-600', isDark);
      darkBtn.classList.toggle('dark:text-blue-400', isDark);
    }
  }

  document.addEventListener('gf-theme-change', syncThemeSegments);
  document.addEventListener('DOMContentLoaded', syncThemeSegments);
  const themeObserver = new MutationObserver(syncThemeSegments);
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('theme-btn-light')?.addEventListener('click', function () {
      window.applySiteTheme && window.applySiteTheme('light');
    });
    document.getElementById('theme-btn-dark')?.addEventListener('click', function () {
      window.applySiteTheme && window.applySiteTheme('dark');
    });
    syncThemeSegments();
  });

  // Mobile menu toggle
  window.toggleMobileMenu = function() {
    const menu = document.getElementById('mobile-menu');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuIcon = menuBtn.querySelector('.menu-icon');
    const closeIcon = menuBtn.querySelector('.close-icon');
    
    menu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
  };

  // Global search modal
  (function () {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('close-search-btn');
    const form = document.getElementById('global-search-form');
    const input = document.getElementById('global-search-input');

    if (!modal || !openBtn || !closeBtn || !form || !input) {
      return;
    }

    const openModal = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex', 'flex-col', 'items-center');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => input.focus());
    };

    const closeModal = () => {
      modal.classList.remove('flex', 'flex-col', 'items-center');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('flex')) {
        closeModal();
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openModal();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const rawQuery = input.value.trim();
      const url = rawQuery ? `/notes?q=${encodeURIComponent(rawQuery)}` : '/notes';
      window.location.href = url;
    });
  })();

  // Navbar scroll effect
  (function() {
    const navbar = document.getElementById('navbar');
    
    function updateNavbar() {
      const scrollY = window.scrollY;
      
      if (scrollY > 50) {
        navbar.classList.add('is-scrolled');
      } else {
        navbar.classList.remove('is-scrolled');
      }
    }
    
    window.addEventListener('scroll', updateNavbar, { passive: true });
    updateNavbar();
  })();
</script>

<style>
  /* Ensure smooth transitions */
  #mobile-menu {
    transition: opacity 200ms ease;
  }
  
  #mobile-menu.hidden {
    opacity: 0;
    pointer-events: none;
  }
  
  #mobile-menu:not(.hidden) {
    opacity: 1;
  }

  #navbar.is-scrolled {
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(16px);
    background: color-mix(in srgb, var(--color-bg-primary) 82%, transparent);
  }
</style>
