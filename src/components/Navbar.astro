---
const navItems = [
  { href: '/discovery', label: '探索', en: 'Explore' },
  { href: '/notes', label: '笔记', en: 'Notes' },
  { href: '/collections', label: '专辑', en: 'Collections' },
  { href: '/upload', label: '上传', en: 'Upload' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isNavActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a class="text-xl font-display font-bold tracking-tight" href="/">
      GLOBAL FRAME
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium tracking-wide">
      {navItems.map(item => (
        <a 
          class:list={[
            "relative group transition-colors",
            { "text-blue-500 dark:text-blue-400": isNavActive(item.href) }
          ]} 
          href={item.href}
        >
          {item.label}
          <span class:list={[
            "absolute -bottom-1 left-0 w-full h-0.5 bg-blue-500 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left",
            { "scale-x-100": isNavActive(item.href) }
          ]}></span>
        </a>
      ))}
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- Search Button -->
      <button
        id="open-search-btn"
        class="p-2 rounded-full transition-colors hover:bg-black/5 dark:hover:bg-white/10"
        aria-label="Search"
      >
        <span class="material-symbols-outlined text-xl">search</span>
      </button>
      
      <!-- Theme Toggle -->
      <button 
        class="p-2 hover:bg-white/10 dark:hover:bg-white/10 rounded-full transition-colors"
        onclick="toggleDarkMode()"
        aria-label="Toggle dark mode"
      >
        <span class="material-symbols-outlined dark-icon text-xl hidden">dark_mode</span>
        <span class="material-symbols-outlined light-icon text-xl">light_mode</span>
      </button>

      <!-- Upload CTA (Desktop) -->
      <a href="/upload" class="hidden md:inline-flex">
        <button class="bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-full text-sm font-medium transition-colors">
          加入社区
        </button>
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 hover:bg-white/10 rounded-full transition-colors"
        onclick="toggleMobileMenu()"
        aria-label="Toggle menu"
      >
        <span class="material-symbols-outlined text-xl menu-icon">menu</span>
        <span class="material-symbols-outlined text-xl close-icon hidden">close</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 backdrop-blur-lg border-b border-default"
    style="background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);"
  >
    <div class="px-6 py-4 space-y-3">
      {navItems.map(item => (
        <a 
          class:list={[
            "block py-3 px-4 rounded-xl transition-colors",
            { 
              "bg-blue-500/20 text-blue-400": isNavActive(item.href),
              "hover:bg-white/5": !isNavActive(item.href)
            }
          ]} 
          href={item.href}
        >
          <span class="font-medium">{item.label}</span>
          <span class="text-xs text-white/40 ml-2">{item.en}</span>
        </a>
      ))}
      <a href="/upload" class="block mt-4">
        <button class="w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-full text-sm font-medium transition-colors">
          加入社区
        </button>
      </a>
    </div>
  </div>
</nav>

<div
  id="global-search-modal"
  class="fixed inset-0 z-[70] hidden items-start justify-center bg-black/50 px-4 pt-20 md:pt-24"
  role="dialog"
  aria-modal="true"
  aria-labelledby="global-search-title"
>
  <div class="w-full max-w-2xl rounded-3xl border border-default bg-surface p-5 shadow-2xl md:p-6">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p id="global-search-title" class="text-base font-semibold">全局搜索</p>
        <p class="text-xs text-secondary">输入关键词并回车，快速跳转到笔记列表检索。</p>
      </div>
      <button
        id="close-search-btn"
        class="rounded-full p-2 transition-colors hover:bg-black/5 dark:hover:bg-white/10"
        aria-label="Close search"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <form id="global-search-form" class="mt-4 flex gap-2">
      <input
        id="global-search-input"
        class="w-full rounded-2xl border border-default bg-transparent px-4 py-3 text-sm outline-none transition focus:border-blue-400"
        type="search"
        placeholder="例如：构图 / 镜头 / 日常"
        autocomplete="off"
      />
      <button class="rounded-2xl bg-blue-500 px-5 py-3 text-sm font-medium text-white transition hover:bg-blue-600" type="submit">
        搜索
      </button>
    </form>

    <div class="mt-4 grid gap-2 sm:grid-cols-3">
      <a class="rounded-2xl border border-default px-4 py-3 text-sm transition hover:border-blue-400 hover:text-blue-500" href="/discovery">前往探索页</a>
      <a class="rounded-2xl border border-default px-4 py-3 text-sm transition hover:border-blue-400 hover:text-blue-500" href="/upload">前往上传页</a>
      <a class="rounded-2xl border border-default px-4 py-3 text-sm transition hover:border-blue-400 hover:text-blue-500" href="/notes">前往笔记页</a>
    </div>
  </div>
</div>

<script is:inline>
  // Theme icon update
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.dark-icon').forEach(el => {
      el.classList.toggle('hidden', !isDark);
    });
    document.querySelectorAll('.light-icon').forEach(el => {
      el.classList.toggle('hidden', isDark);
    });
  }
  
  // Initial update
  (function() {
    updateThemeIcons();
  })();
  
  // Watch for changes
  const observer = new MutationObserver(updateThemeIcons);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

  // Mobile menu toggle
  window.toggleMobileMenu = function() {
    const menu = document.getElementById('mobile-menu');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuIcon = menuBtn.querySelector('.menu-icon');
    const closeIcon = menuBtn.querySelector('.close-icon');
    
    menu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
  };

  // Global search modal
  (function () {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('close-search-btn');
    const form = document.getElementById('global-search-form');
    const input = document.getElementById('global-search-input');

    if (!modal || !openBtn || !closeBtn || !form || !input) {
      return;
    }

    const openModal = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      input.focus();
    };

    const closeModal = () => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('flex')) {
        closeModal();
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openModal();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const rawQuery = input.value.trim();
      const url = rawQuery ? `/notes?q=${encodeURIComponent(rawQuery)}` : '/notes';
      window.location.href = url;
    });
  })();

  // Navbar scroll effect
  (function() {
    const navbar = document.getElementById('navbar');
    
    function updateNavbar() {
      const scrollY = window.scrollY;
      
      if (scrollY > 50) {
        navbar.classList.add('is-scrolled');
      } else {
        navbar.classList.remove('is-scrolled');
      }
    }
    
    window.addEventListener('scroll', updateNavbar, { passive: true });
    updateNavbar();
  })();
</script>

<style>
  /* Ensure smooth transitions */
  #mobile-menu {
    transition: opacity 200ms ease;
  }
  
  #mobile-menu.hidden {
    opacity: 0;
    pointer-events: none;
  }
  
  #mobile-menu:not(.hidden) {
    opacity: 1;
  }

  #navbar.is-scrolled {
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(16px);
    background: color-mix(in srgb, var(--color-bg-primary) 82%, transparent);
  }
</style>
