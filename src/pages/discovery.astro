---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PhotoViewer from '../components/gallery/PhotoViewer.astro';
import { galleryMedia } from '../lib/media';

const photos = galleryMedia;
const categories = ['全部', ...new Set(photos.map((photo) => photo.category))];
const photosJson = JSON.stringify(photos);
const categoriesJson = JSON.stringify(categories);
---

<Layout title="探索 | Global Frame">
  <Navbar />
  <PhotoViewer photos={photos} />
  
  <main class="pt-28 pb-24 px-6 min-h-screen bg-secondary text-primary">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-display font-bold text-primary mb-4">发现精彩作品</h1>
        <p class="text-secondary max-w-2xl mx-auto">
          探索全球摄影师的精彩作品，每一张照片都有一个故事
        </p>
      </div>

      <!-- Filters + View Toggle -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <!-- Category Filters -->
        <div class="flex flex-wrap items-center gap-2" id="filter-bar">
          {categories.map((cat, i) => (
            <button 
              class:list={[
                "px-4 py-2 rounded-full text-sm font-medium transition-all",
                i === 0 
                  ? "bg-blue-500 text-white border border-blue-500" 
                  : "chip-neutral"
              ]}
              data-filter={cat}
            >
              {cat}
            </button>
          ))}
        </div>
        
        <!-- View Toggle -->
        <div class="flex items-center gap-1 rounded-full p-1 chip-neutral" id="view-toggle">
          <button 
            class="view-btn p-2 rounded-full bg-blue-500 text-white transition-all" 
            data-view="grid"
            aria-label="Grid view"
          >
            <span class="material-symbols-outlined text-xl">grid_view</span>
          </button>
          <button 
            class="view-btn p-2 rounded-full text-secondary hover:bg-black/5 dark:hover:bg-white/10 transition-all" 
            data-view="timeline"
            aria-label="Timeline view"
          >
            <span class="material-symbols-outlined text-xl">view_timeline</span>
          </button>
          <button 
            class="view-btn p-2 rounded-full text-secondary hover:bg-black/5 dark:hover:bg-white/10 transition-all" 
            data-view="map"
            aria-label="Map view"
          >
            <span class="material-symbols-outlined text-xl">map</span>
          </button>
        </div>
      </div>

      <!-- Grid View -->
      <div id="view-grid" class="view-content">
        <div id="discovery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {photos.map((photo, index) => (
            <article 
              class="group glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:border-blue-500/50 hover:shadow-[0_0_40px_rgba(59,130,246,0.2)] hover:-translate-y-1"
              data-category={photo.category}
              data-index={index}
              data-testid="gallery-card"
            >
              <div class="aspect-[4/3] overflow-hidden relative">
                  <img
                    src={photo.thumbnail || photo.url}
                  alt={photo.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity" />
                
                <!-- Location Badge -->
                <div class="absolute top-4 left-4 bg-black/40 backdrop-blur-md rounded-full px-3 py-1 flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm text-blue-400">location_on</span>
                  <span class="text-white/90 text-sm">{photo.location}</span>
                </div>
                
                <!-- View Button -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <button 
                    class="open-viewer-btn bg-white/20 backdrop-blur-sm text-white py-3 px-6 rounded-full text-sm font-medium hover:bg-white/30 transition-colors flex items-center gap-2"
                    data-index={index}
                  >
                    <span class="material-symbols-outlined text-sm">fullscreen</span>
                    查看大图
                  </button>
                </div>
              </div>
              <div class="p-5">
                <h3 class="text-primary font-medium text-lg mb-2">{photo.title}</h3>
                <div class="flex items-center justify-between">
                  <p class="text-secondary text-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">person</span>
                    {photo.photographer}
                  </p>
                  <p class="text-secondary text-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">calendar_today</span>
                    {photo.meta.capturedAt ? new Date(photo.meta.capturedAt).toLocaleDateString('zh-CN') : '--'}
                  </p>
                  <div class="flex gap-1">
                    {photo.tags.slice(0, 2).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded-full chip-neutral">{tag}</span>
                    ))}
                  </div>
                </div>
                <div class="mt-2 text-xs text-muted flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">photo_camera</span>
                  {[photo.meta.cameraMake, photo.meta.cameraModel].filter(Boolean).join(' ') || '--'}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
      
      <!-- Timeline View (Hidden by default) -->
      <div id="view-timeline" class="view-content hidden">
        <div class="space-y-8">
          {['2026年4月', '2026年3月', '2026年2月', '2026年1月'].map((month, mi) => (
            <div class="relative">
              <div class="sticky top-28 z-10 mb-4">
                <span class="bg-blue-500/20 text-blue-400 px-4 py-2 rounded-full text-sm font-medium backdrop-blur-md">
                  {month}
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pl-8 border-l border-default">
                {photos.filter((_, i) => i % 4 === mi % 3).map(photo => (
                  <article class="group glass-card rounded-2xl overflow-hidden cursor-pointer transition-all hover:border-blue-500/50">
                    <div class="aspect-[4/3] overflow-hidden relative">
                      <img src={photo.thumbnail} alt={photo.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                    </div>
                    <div class="p-4">
                      <h3 class="text-primary font-medium">{photo.title}</h3>
                      <p class="text-secondary text-sm">{photo.location}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Map View (Hidden by default) -->
      <div id="view-map" class="view-content hidden">
        <div id="discovery-map" class="h-[600px] rounded-2xl overflow-hidden border border-default"></div>
        <p class="text-center text-muted mt-4 text-sm">点击地图上的标记查看照片</p>
      </div>

      <!-- Load More -->
      <div class="text-center mt-12">
        <button class="chip-neutral text-primary px-8 py-3 rounded-full font-medium transition-colors inline-flex items-center gap-2" id="load-more-btn">
          <span class="material-symbols-outlined">refresh</span>
          加载更多
        </button>
      </div>
    </div>
  </main>
  
  <footer class="site-footer py-8 px-6">
    <div class="max-w-7xl mx-auto text-center text-muted text-sm">
      © 2026 Global Frame. All rights reserved.
    </div>
  </footer>
</Layout>

<script define:vars={{ photosJson, categoriesJson }}>
  const LOCAL_STORAGE_KEY = 'gf-discovery-media';
  const photos = JSON.parse(photosJson);
  const categories = JSON.parse(categoriesJson);
  const discoveryGrid = document.getElementById('discovery-grid');
  const filterBar = document.getElementById('filter-bar');

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function normalizePhoto(raw, fallbackIndex) {
    return {
      id: raw.id ?? `local-${fallbackIndex}`,
      mediaType: raw.mediaType ?? 'image',
      title: raw.title ?? '未命名媒体',
      location: raw.location ?? '待补充位置',
      url: raw.url ?? '',
      thumbnail: raw.thumbnail ?? raw.url ?? '',
      photographer: raw.photographer ?? '上传者',
      category: raw.category ?? '上传',
      tags: Array.isArray(raw.tags) ? raw.tags : [],
      meta: raw.meta ?? {},
    };
  }

  function ensureFilterButton(category) {
    if (!filterBar || categories.includes(category)) return;
    categories.push(category);
    const filterButton = document.createElement('button');
    filterButton.className = 'chip-neutral px-4 py-2 rounded-full text-sm font-medium transition-all';
    filterButton.dataset.filter = category;
    filterButton.textContent = category;
    filterBar.appendChild(filterButton);
  }

  function hydrateLocalMedia() {
    const localMediaRaw = localStorage.getItem(LOCAL_STORAGE_KEY);
    if (!localMediaRaw) return;
    try {
      const parsedMedia = JSON.parse(localMediaRaw);
      if (!Array.isArray(parsedMedia) || parsedMedia.length === 0) return;
      const normalized = parsedMedia.map((item, index) => normalizePhoto(item, index));
      photos.unshift(...normalized);
      normalized.forEach((item) => ensureFilterButton(item.category));
    } catch (_error) {
      // Ignore malformed local media cache and fallback to built-in media.
    }
  }

  function renderDiscoveryGrid(data) {
    if (!discoveryGrid) return;
    discoveryGrid.innerHTML = data
      .map((photo, index) => {
        const cameraLabel =
          [photo.meta?.cameraMake, photo.meta?.cameraModel].filter(Boolean).join(' ').trim() || '--';
        const dateLabel = photo.meta?.capturedAt
          ? new Date(photo.meta.capturedAt).toLocaleDateString('zh-CN')
          : '--';
        const tags = (photo.tags || [])
          .slice(0, 2)
          .map(
            (tag) =>
              `<span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/60">${escapeHtml(tag)}</span>`
          )
          .join('');
        return `
          <article
            class="group glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:border-blue-500/50 hover:shadow-[0_0_40px_rgba(59,130,246,0.2)] hover:-translate-y-1"
            data-category="${escapeHtml(photo.category)}"
            data-index="${index}"
            data-testid="gallery-card"
          >
            <div class="aspect-[4/3] overflow-hidden relative">
              <img
                src="${escapeHtml(photo.thumbnail || photo.url)}"
                alt="${escapeHtml(photo.title)}"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute top-4 left-4 bg-black/40 backdrop-blur-md rounded-full px-3 py-1 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-blue-400">location_on</span>
                <span class="text-white/90 text-sm">${escapeHtml(photo.location)}</span>
              </div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                <button
                  class="open-viewer-btn bg-white/20 backdrop-blur-sm text-white py-3 px-6 rounded-full text-sm font-medium hover:bg-white/30 transition-colors flex items-center gap-2"
                  data-index="${index}"
                >
                  <span class="material-symbols-outlined text-sm">fullscreen</span>
                  查看大图
                </button>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-primary font-medium text-lg mb-2">${escapeHtml(photo.title)}</h3>
              <div class="flex items-center justify-between">
                <p class="text-secondary text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">person</span>
                  ${escapeHtml(photo.photographer)}
                </p>
                <p class="text-secondary text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">calendar_today</span>
                  ${dateLabel}
                </p>
                <div class="flex gap-1">${tags}</div>
              </div>
              <div class="mt-2 text-xs text-muted flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">photo_camera</span>
                ${escapeHtml(cameraLabel)}
              </div>
            </div>
          </article>
        `;
      })
      .join('');
  }

  function syncViewerData() {
    if (typeof window.setPhotoViewerPhotos === 'function') {
      window.setPhotoViewerPhotos(photos);
    }
  }

  hydrateLocalMedia();
  renderDiscoveryGrid(photos);
  syncViewerData();

  const viewToggle = document.getElementById('view-toggle');
  const viewContents = document.querySelectorAll('.view-content');

  viewToggle?.addEventListener('click', (e) => {
    const target = e.target;
    const btn = target.closest('.view-btn');
    if (!btn) return;

    const view = btn.dataset.view;
    viewToggle.querySelectorAll('.view-btn').forEach((b) => {
      if (b === btn) {
        b.classList.add('bg-blue-500', 'text-white');
        b.classList.remove('text-secondary');
      } else {
        b.classList.remove('bg-blue-500', 'text-white');
        b.classList.add('text-secondary');
      }
    });

    viewContents.forEach((content) => {
      content.classList.add('hidden');
    });
    document.getElementById(`view-${view}`)?.classList.remove('hidden');

    if (view === 'map') {
      initMap();
    }
  });

  discoveryGrid?.addEventListener('click', (e) => {
    const target = e.target;
    const openBtn = target.closest('.open-viewer-btn');
    if (openBtn) {
      e.preventDefault();
      e.stopPropagation();
      const index = Number(openBtn.dataset.index || '0');
      if (window.openPhotoViewer) {
        window.openPhotoViewer(index);
      }
      return;
    }

    const card = target.closest('[data-index]');
    if (!card) return;
    const index = Number(card.dataset.index || '0');
    if (window.openPhotoViewer) {
      window.openPhotoViewer(index);
    }
  });

  filterBar?.addEventListener('click', (e) => {
    const target = e.target;
    const btn = target.closest('[data-filter]');
    if (!btn) return;

    const filter = btn.dataset.filter;
    filterBar.querySelectorAll('[data-filter]').forEach((b) => {
      if (b === btn) {
        b.classList.add('bg-blue-500', 'text-white', 'border-blue-500');
        b.classList.remove('chip-neutral');
      } else {
        b.classList.remove('bg-blue-500', 'text-white', 'border-blue-500');
        b.classList.add('chip-neutral');
      }
    });

    document.querySelectorAll('[data-category]').forEach((card) => {
      const el = card;
      const category = el.dataset.category ?? '';
      if (filter === '全部' || category.split('|').includes(filter)) {
        el.style.display = '';
        el.style.animation = 'fadeSlideUp 0.3s ease-out';
      } else {
        el.style.display = 'none';
      }
    });
  });

  document.getElementById('load-more-btn')?.addEventListener('click', () => {
    alert('加载更多功能开发中，敬请期待！');
  });

  let mapInitialized = false;
  let map = null;
  function initMap() {
    if (mapInitialized && map) {
      map.invalidateSize();
      return;
    }
    const mapContainer = document.getElementById('discovery-map');
    if (!mapContainer) return;

    const leaflet = window.L;
    if (!leaflet) {
      console.warn('Leaflet runtime is unavailable.');
      return;
    }

    const isDark = document.documentElement.classList.contains('dark');
    map = leaflet.map('discovery-map', {
      center: [20, 0],
      zoom: 2,
      attributionControl: false,
    });

    const tileUrl = isDark
      ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
      : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';
    leaflet.tileLayer(tileUrl, {
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    photos.forEach((photo, index) => {
      const lat = Number(photo.meta?.lat);
      const lng = Number(photo.meta?.lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
      const marker = leaflet.marker([lat, lng]).addTo(map);
      const popupContent = `
        <div style="min-width: 200px;">
          <img src="${escapeHtml(photo.thumbnail || photo.url)}" alt="${escapeHtml(photo.title)}" style="width: 100%; border-radius: 8px; margin-bottom: 8px;" />
          <h3 style="color: #333; font-weight: 600; margin-bottom: 4px;">${escapeHtml(photo.title)}</h3>
          <p style="color: #666; font-size: 12px;">${escapeHtml(photo.location)}</p>
          <button
            onclick="window.openPhotoViewer && window.openPhotoViewer(${index})"
            style="margin-top: 8px; width: 100%; padding: 8px; background: #3B82F6; color: white; border: none; border-radius: 6px; cursor: pointer;"
          >
            查看大图
          </button>
        </div>
      `;
      marker.bindPopup(popupContent);
    });

    mapInitialized = true;
  }
</script>

<style>
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
