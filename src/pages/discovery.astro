---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PhotoGrid from '../components/gallery/PhotoGrid.astro';
import PhotoViewer from '../components/gallery/PhotoViewer.astro';

const photos = [
  { id: '1', location: '云南·大理', lat: 25.6065, lng: 100.2679, title: '洱海晨曦', url: 'https://images.unsplash.com/photo-1528183429752-8e2a3f8f94b9?w=1200', thumbnail: 'https://images.unsplash.com/photo-1528183429752-8e2a3f8f94b9?w=600', photographer: '摄影师A', category: '自然', takenAt: '2026-03-15', tags: ['自然', '湖泊'] },
  { id: '2', location: '西藏·拉萨', lat: 29.6520, lng: 91.1721, title: '布达拉宫', url: 'https://images.unsplash.com/photo-1548013146-72479768bada?w=1200', thumbnail: 'https://images.unsplash.com/photo-1548013146-72479768bada?w=600', photographer: '摄影师B', category: '建筑', takenAt: '2026-03-10', tags: ['建筑', '宗教'] },
  { id: '3', location: '冰岛·雷克雅未克', lat: 64.1466, lng: -21.9426, title: '极光之夜', url: 'https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=1200', thumbnail: 'https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=600', photographer: '摄影师C', category: '自然', takenAt: '2026-02-28', tags: ['极光', '夜景'] },
  { id: '4', location: '日本·京都', lat: 35.0116, lng: 135.7681, title: '竹林绿意', url: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200', thumbnail: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=600', photographer: '摄影师D', category: '自然', takenAt: '2026-04-01', tags: ['竹林', '日本'] },
  { id: '5', location: '挪威·特罗姆瑟', lat: 69.6496, lng: 18.9560, title: '极光探险', url: 'https://images.unsplash.com/photo-1483347756197-71ef80e95f73?w=1200', thumbnail: 'https://images.unsplash.com/photo-1483347756197-71ef80e95f73?w=600', photographer: '摄影师E', category: '自然', takenAt: '2026-01-20', tags: ['极光', '探险'] },
  { id: '6', location: '新西兰·皇后镇', lat: -45.0312, lng: 168.6626, title: '湖光山色', url: 'https://images.unsplash.com/photo-1507699622108-4be3abd695ad?w=1200', thumbnail: 'https://images.unsplash.com/photo-1507699622108-4be3abd695ad?w=600', photographer: '摄影师F', category: '自然', takenAt: '2026-02-15', tags: ['湖泊', '山脉'] },
  { id: '7', location: '瑞士·因特拉肯', lat: 46.6863, lng: 7.8632, title: '少女峰', url: 'https://images.unsplash.com/photo-1531210483974-4f8c1f33fd35?w=1200', thumbnail: 'https://images.unsplash.com/photo-1531210483974-4f8c1f33fd35?w=600', photographer: '摄影师G', category: '自然', takenAt: '2026-03-22', tags: ['雪山', '瑞士'] },
  { id: '8', location: '意大利·威尼斯', lat: 45.4408, lng: 12.3155, title: '水城时光', url: 'https://images.unsplash.com/photo-1514890547357-a9ee288728e0?w=1200', thumbnail: 'https://images.unsplash.com/photo-1514890547357-a9ee288728e0?w=600', photographer: '摄影师H', category: '城市', takenAt: '2026-04-05', tags: ['水城', '意大利'] },
  { id: '9', location: '希腊·圣托里尼', lat: 36.3932, lng: 25.4615, title: '蓝顶白墙', url: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=1200', thumbnail: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=600', photographer: '摄影师I', category: '城市', takenAt: '2026-03-28', tags: ['希腊', '爱琴海'] },
];

const categories = ['全部', '自然', '城市', '建筑'];
const photosJson = JSON.stringify(photos);
---

<Layout title="探索 | Global Frame">
  <Navbar />
  <PhotoViewer photos={photos} />
  
  <main class="pt-28 pb-24 px-6 min-h-screen bg-[#0A0A0F]">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-display font-bold text-white mb-4">发现精彩作品</h1>
        <p class="text-white/60 max-w-2xl mx-auto">
          探索全球摄影师的精彩作品，每一张照片都有一个故事
        </p>
      </div>

      <!-- Filters + View Toggle -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <!-- Category Filters -->
        <div class="flex flex-wrap items-center gap-2" id="filter-bar">
          {categories.map((cat, i) => (
            <button 
              class:list={[
                "px-4 py-2 rounded-full text-sm font-medium transition-all",
                i === 0 
                  ? "bg-blue-500 text-white" 
                  : "bg-white/10 text-white/70 hover:bg-white/20 hover:text-white"
              ]}
              data-filter={cat}
            >
              {cat}
            </button>
          ))}
        </div>
        
        <!-- View Toggle -->
        <div class="flex items-center gap-1 bg-white/5 rounded-full p-1" id="view-toggle">
          <button 
            class="view-btn p-2 rounded-full bg-white/10 text-white transition-all" 
            data-view="grid"
            aria-label="Grid view"
          >
            <span class="material-symbols-outlined text-xl">grid_view</span>
          </button>
          <button 
            class="view-btn p-2 rounded-full text-white/50 hover:bg-white/10 transition-all" 
            data-view="timeline"
            aria-label="Timeline view"
          >
            <span class="material-symbols-outlined text-xl">view_timeline</span>
          </button>
          <button 
            class="view-btn p-2 rounded-full text-white/50 hover:bg-white/10 transition-all" 
            data-view="map"
            aria-label="Map view"
          >
            <span class="material-symbols-outlined text-xl">map</span>
          </button>
        </div>
      </div>

      <!-- Grid View -->
      <div id="view-grid" class="view-content">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {photos.map((photo, index) => (
            <article 
              class="group glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:border-blue-500/50 hover:shadow-[0_0_40px_rgba(59,130,246,0.2)] hover:-translate-y-1"
              data-category={photo.category}
              data-index={index}
            >
              <div class="aspect-[4/3] overflow-hidden relative">
                <img 
                  src={photo.thumbnail} 
                  alt={photo.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity" />
                
                <!-- Location Badge -->
                <div class="absolute top-4 left-4 bg-black/40 backdrop-blur-md rounded-full px-3 py-1 flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm text-blue-400">location_on</span>
                  <span class="text-white/90 text-sm">{photo.location}</span>
                </div>
                
                <!-- View Button -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <button 
                    class="open-viewer-btn bg-white/20 backdrop-blur-sm text-white py-3 px-6 rounded-full text-sm font-medium hover:bg-white/30 transition-colors flex items-center gap-2"
                    data-index={index}
                  >
                    <span class="material-symbols-outlined text-sm">fullscreen</span>
                    查看大图
                  </button>
                </div>
              </div>
              <div class="p-5">
                <h3 class="text-white font-medium text-lg mb-2">{photo.title}</h3>
                <div class="flex items-center justify-between">
                  <p class="text-white/50 text-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">person</span>
                    {photo.photographer}
                  </p>
                  <div class="flex gap-1">
                    {photo.tags.slice(0, 2).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/60">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
      
      <!-- Timeline View (Hidden by default) -->
      <div id="view-timeline" class="view-content hidden">
        <div class="space-y-8">
          {['2026年4月', '2026年3月', '2026年2月', '2026年1月'].map((month, mi) => (
            <div class="relative">
              <div class="sticky top-28 z-10 mb-4">
                <span class="bg-blue-500/20 text-blue-400 px-4 py-2 rounded-full text-sm font-medium backdrop-blur-md">
                  {month}
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pl-8 border-l border-white/10">
                {photos.filter((_, i) => i % 4 === mi % 3).map(photo => (
                  <article class="group glass-card rounded-2xl overflow-hidden cursor-pointer transition-all hover:border-blue-500/50">
                    <div class="aspect-[4/3] overflow-hidden relative">
                      <img src={photo.thumbnail} alt={photo.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                    </div>
                    <div class="p-4">
                      <h3 class="text-white font-medium">{photo.title}</h3>
                      <p class="text-white/50 text-sm">{photo.location}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Map View (Hidden by default) -->
      <div id="view-map" class="view-content hidden">
        <div id="discovery-map" class="h-[600px] rounded-2xl overflow-hidden border border-white/10"></div>
        <p class="text-center text-white/40 mt-4 text-sm">点击地图上的标记查看照片</p>
      </div>

      <!-- Load More -->
      <div class="text-center mt-12">
        <button class="bg-white/10 hover:bg-white/20 text-white px-8 py-3 rounded-full font-medium transition-colors inline-flex items-center gap-2" id="load-more-btn">
          <span class="material-symbols-outlined">refresh</span>
          加载更多
        </button>
      </div>
    </div>
  </main>
  
  <footer class="bg-black/50 backdrop-blur-sm border-t border-white/10 py-8 px-6">
    <div class="max-w-7xl mx-auto text-center text-white/40 text-sm">
      © 2026 Global Frame. All rights reserved.
    </div>
  </footer>
</Layout>

<script define:vars={{ photosJson }}>
  const photos = JSON.parse(photosJson);
  
  // View switching
  const viewToggle = document.getElementById('view-toggle');
  const viewContents = document.querySelectorAll('.view-content');
  
  viewToggle?.addEventListener('click', (e) => {
    const btn = e.target.closest('.view-btn');
    if (!btn) return;
    
    const view = btn.dataset.view;
    
    // Update active button
    viewToggle.querySelectorAll('.view-btn').forEach(b => {
      if (b === btn) {
        b.classList.add('bg-white/10', 'text-white');
        b.classList.remove('text-white/50');
      } else {
        b.classList.remove('bg-white/10', 'text-white');
        b.classList.add('text-white/50');
      }
    });
    
    // Show selected view
    viewContents.forEach(content => {
      content.classList.add('hidden');
    });
    document.getElementById(`view-${view}`)?.classList.remove('hidden');
    
    // Initialize map if needed
    if (view === 'map') {
      initMap();
    }
  });
  
  // Photo Viewer integration
  document.querySelectorAll('.open-viewer-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const index = parseInt(btn.dataset.index || '0');
      if (window.openPhotoViewer) {
        window.openPhotoViewer(index);
      }
    });
  });
  
  // Also make entire card clickable
  document.querySelectorAll('[data-index]').forEach(card => {
    if (!card.classList.contains('open-viewer-btn')) {
      card.style.cursor = 'pointer';
      card.addEventListener('click', (e) => {
        if (!e.target.closest('.open-viewer-btn')) {
          const index = parseInt(card.dataset.index || '0');
          if (window.openPhotoViewer) {
            window.openPhotoViewer(index);
          }
        }
      });
    }
  });
  
  // Filter functionality
  const filterBar = document.getElementById('filter-bar');
  const photoGrid = document.getElementById('view-grid');
  
  filterBar?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-filter]');
    if (!btn) return;
    
    const filter = btn.dataset.filter;
    
    filterBar.querySelectorAll('[data-filter]').forEach(b => {
      if (b === btn) {
        b.classList.add('bg-blue-500', 'text-white');
        b.classList.remove('bg-white/10', 'text-white/70', 'hover:bg-white/20', 'hover:text-white');
      } else {
        b.classList.remove('bg-blue-500', 'text-white');
        b.classList.add('bg-white/10', 'text-white/70', 'hover:bg-white/20', 'hover:text-white');
      }
    });
    
    photoGrid?.querySelectorAll('[data-category]').forEach(card => {
      const el = card;
      if (filter === '全部' || el.dataset.category === filter) {
        el.style.display = '';
        el.style.animation = 'fadeSlideUp 0.3s ease-out';
      } else {
        el.style.display = 'none';
      }
    });
  });
  
  // Load more placeholder
  document.getElementById('load-more-btn')?.addEventListener('click', () => {
    alert('加载更多功能开发中，敬请期待！');
  });
  
  // Map initialization
  let mapInitialized = false;
  function initMap() {
    if (mapInitialized) return;
    
    const mapContainer = document.getElementById('discovery-map');
    if (!mapContainer) return;
    
    // Check if leaflet is available
    if (typeof L === 'undefined') {
      console.warn('Leaflet not loaded');
      return;
    }
    
    const map = L.map('discovery-map', {
      center: [20, 0],
      zoom: 2,
      attributionControl: false,
    });
    
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);
    
    // Add markers
    photos.forEach((photo, index) => {
      if (photo.lat && photo.lng) {
        const marker = L.marker([photo.lat, photo.lng]).addTo(map);
        
        const popupContent = `
          <div style="min-width: 200px;">
            <img src="${photo.thumbnail}" alt="${photo.title}" style="width: 100%; border-radius: 8px; margin-bottom: 8px;" />
            <h3 style="color: #333; font-weight: 600; margin-bottom: 4px;">${photo.title}</h3>
            <p style="color: #666; font-size: 12px;">${photo.location}</p>
            <button 
              onclick="window.openPhotoViewer && window.openPhotoViewer(${index})"
              style="margin-top: 8px; width: 100%; padding: 8px; background: #3B82F6; color: white; border: none; border-radius: 6px; cursor: pointer;"
            >
              查看大图
            </button>
          </div>
        `;
        
        marker.bindPopup(popupContent);
      }
    });
    
    mapInitialized = true;
  }
</script>

<style>
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
