---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

// Get related notes (same tags)
const allNotes = await getCollection('notes');
const relatedNotes = allNotes
  .filter(n => n.id !== note.id)
  .filter(n => n.data.tags.some(tag => note.data.tags.includes(tag)))
  .slice(0, 3);
---

<Layout title={`${note.data.title} | Global Frame`} description={note.data.description}>
  <Navbar />
  
  <main class="pt-28 pb-24 px-6 min-h-screen bg-secondary text-primary">
    <article class="max-w-3xl mx-auto">
      <!-- Back button -->
      <a 
        href="/notes" 
        class="inline-flex items-center gap-2 text-secondary hover:text-primary mb-8 transition-colors"
      >
        <span class="material-symbols-outlined">arrow_back</span>
        所有笔记
      </a>
      
      <!-- Cover image -->
      {note.data.cover && (
        <div class="aspect-video rounded-2xl overflow-hidden mb-8 border border-default">
          <img 
            src={note.data.cover} 
            alt={note.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <!-- Header -->
      <header class="mb-12">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-4">
          {note.data.tags.map(tag => (
            <a 
              href={`/notes?tag=${tag}`}
              class="text-xs px-3 py-1 rounded-full bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
        
        <!-- Title -->
        <h1 class="text-4xl font-bold text-primary mb-4 leading-tight">
          {note.data.title}
        </h1>
        
        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-4 text-secondary text-sm">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">calendar_today</span>
            {note.data.date.toLocaleDateString('zh-CN', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </span>
          {note.data.readingTime && (
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">schedule</span>
              {note.data.readingTime} 分钟阅读
            </span>
          )}
        </div>
      </header>
      
      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <Content />
      </div>
      
      <!-- Divider -->
      <hr class="border-default my-12" />
      
      <!-- Related Notes -->
      {relatedNotes.length > 0 && (
        <section>
          <h2 class="text-xl font-semibold text-primary mb-6">相关笔记</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedNotes.map(related => (
              <a 
                href={`/notes/${related.id}`}
                class="group glass-card rounded-xl overflow-hidden transition-all hover:border-blue-500/50"
              >
                {related.data.cover && (
                  <div class="aspect-video overflow-hidden">
                    <img 
                      src={related.data.cover} 
                      alt={related.data.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}
                <div class="p-4">
                  <h3 class="text-primary font-medium truncate mb-1">
                    {related.data.title}
                  </h3>
                  <p class="text-muted text-sm">
                    {related.data.date.toLocaleDateString('zh-CN')}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
      
      <!-- Share -->
      <div class="flex items-center justify-center gap-4 mt-12 pt-8 border-t border-default">
        <span class="text-muted text-sm">分享到</span>
        <button class="chip-neutral p-2 rounded-full transition-colors" aria-label="Copy link">
          <span class="material-symbols-outlined text-secondary">link</span>
        </button>
      </div>
    </article>
  </main>
  
  <footer class="site-footer py-8 px-6">
    <div class="max-w-7xl mx-auto text-center text-muted text-sm">
      © 2026 Global Frame. All rights reserved.
    </div>
  </footer>
</Layout>

<style is:global>
  /* Prose styles for markdown content */
  .prose {
    --tw-prose-body: var(--color-text-secondary);
    --tw-prose-headings: var(--color-text-primary);
    --tw-prose-links: var(--color-accent-blue);
    --tw-prose-bold: var(--color-text-primary);
    --tw-prose-code: #F472B6;
    --tw-prose-quotes: var(--color-text-muted);
    --tw-prose-hr: var(--color-border);
    max-width: none;
    line-height: 1.8;
  }
  
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--tw-prose-headings);
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }
  
  .prose h1 { font-size: 2.25rem; }
  .prose h2 { font-size: 1.75rem; border-bottom: 1px solid var(--tw-prose-hr); padding-bottom: 0.5em; }
  .prose h3 { font-size: 1.375rem; }
  
  .prose p {
    margin-bottom: 1.25em;
  }
  
  .prose a {
    color: var(--tw-prose-links);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .prose a:hover {
    color: color-mix(in srgb, var(--color-accent-blue) 78%, white);
  }
  
  .prose strong {
    color: var(--tw-prose-bold);
    font-weight: 600;
  }
  
  .prose code {
    color: var(--tw-prose-code);
    background: color-mix(in srgb, var(--color-bg-surface) 72%, transparent);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }
  
  .prose pre {
    background: color-mix(in srgb, var(--color-bg-primary) 82%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25em;
    overflow-x: auto;
    margin: 1.5em 0;
  }
  
  .prose pre code {
    background: none;
    padding: 0;
    font-size: 0.875em;
    color: var(--color-text-primary);
  }
  
  .prose blockquote {
    border-left: 4px solid var(--tw-prose-links);
    padding-left: 1em;
    margin: 1.5em 0;
    color: var(--tw-prose-quotes);
    font-style: italic;
  }
  
  .prose ul,
  .prose ol {
    margin: 1.25em 0;
    padding-left: 1.5em;
  }
  
  .prose li {
    margin-bottom: 0.5em;
  }
  
  .prose ul > li {
    list-style-type: disc;
  }
  
  .prose ol > li {
    list-style-type: decimal;
  }
  
  .prose img {
    border-radius: 12px;
    margin: 1.5em 0;
  }
  
  .prose hr {
    border-color: var(--tw-prose-hr);
    margin: 2em 0;
  }
  
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
  }
  
  .prose th,
  .prose td {
    border: 1px solid var(--color-border);
    padding: 0.75em;
    text-align: left;
  }
  
  .prose th {
    background: color-mix(in srgb, var(--color-bg-surface) 84%, transparent);
    font-weight: 600;
  }
</style>
