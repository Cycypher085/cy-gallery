---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes', ({ data }) => !data.draft);
notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get all unique tags
const allTags = [...new Set(notes.flatMap(note => note.data.tags))].sort();

// Group notes by tag for sidebar
const recentNotes = notes.slice(0, 5);
---

<Layout title="学习笔记 | Global Frame">
  <Navbar />
  
  <main class="pt-28 pb-24 px-6 min-h-screen bg-secondary text-primary">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="sticky top-28 space-y-6">
            
            <!-- Search -->
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-muted">search</span>
              <input 
                type="text" 
                id="note-search"
                placeholder="搜索笔记..."
                class="input-surface w-full py-3 pl-12 pr-4 transition-colors"
              />
            </div>
            
            <!-- Navigation -->
            <div class="space-y-2">
              <h3 class="text-xs font-medium text-muted uppercase tracking-wider px-4">导航</h3>
              <a href="/notes" class="flex items-center gap-3 px-4 py-2 rounded-xl bg-blue-500/20 text-blue-400">
                <span class="material-symbols-outlined text-xl">article</span>
                全部笔记
              </a>
            </div>
            
            <!-- Tags -->
            <div class="space-y-2">
              <h3 class="text-xs font-medium text-muted uppercase tracking-wider px-4">标签云</h3>
              <div class="flex flex-wrap gap-2 px-4">
                {allTags.map(tag => (
                  <button 
                    class="tag-filter chip-neutral text-xs px-3 py-1.5 rounded-full transition-colors"
                    data-tag={tag}
                  >
                    {tag}
                  </button>
                ))}
              </div>
            </div>
            
            <!-- Recent -->
            <div class="space-y-2">
              <h3 class="text-xs font-medium text-muted uppercase tracking-wider px-4">最近更新</h3>
              <div class="space-y-1">
                {recentNotes.map(note => (
                  <a 
                    href={`/notes/${note.id}`}
                    class="block px-4 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 text-secondary hover:text-primary transition-colors text-sm truncate"
                  >
                    {note.data.title}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
        
        <!-- Main Content -->
        <div class="flex-1 min-w-0">
          <!-- Header -->
          <div class="mb-8">
            <h1 class="text-3xl font-bold text-primary mb-2">学习笔记</h1>
            <p class="text-secondary">记录学习心得，分享技术见解</p>
          </div>
          
          <!-- Notes Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="notes-grid">
            {notes.map(note => (
              <article 
                class="note-card group glass-card rounded-2xl overflow-hidden transition-all duration-500 hover:border-blue-500/50 hover:shadow-[0_0_40px_rgba(59,130,246,0.15)] hover:-translate-y-1"
                data-tags={JSON.stringify(note.data.tags)}
                data-title={note.data.title}
                data-description={note.data.description ?? ''}
              >
                {note.data.cover && (
                  <div class="aspect-video overflow-hidden">
                    <img 
                      src={note.data.cover} 
                      alt={note.data.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                  </div>
                )}
                <div class="p-6">
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2 mb-3">
                    {note.data.tags.slice(0, 3).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400">{tag}</span>
                    ))}
                  </div>
                  
                  <!-- Title -->
                  <h2 class="text-xl font-semibold text-primary mb-2 group-hover:text-blue-400 transition-colors">
                    <a href={`/notes/${note.id}`}>
                      {note.data.title}
                    </a>
                  </h2>
                  
                  <!-- Description -->
                  {note.data.description && (
                    <p class="text-secondary text-sm mb-4 line-clamp-2">
                      {note.data.description}
                    </p>
                  )}
                  
                  <!-- Meta -->
                  <div class="flex items-center gap-4 text-muted text-sm">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-sm">calendar_today</span>
                      {note.data.date.toLocaleDateString('zh-CN')}
                    </span>
                    {note.data.readingTime && (
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">schedule</span>
                        {note.data.readingTime}min
                      </span>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
          
          <!-- Empty state -->
          <div id="no-results" class="hidden text-center py-16">
            <span class="material-symbols-outlined text-6xl text-muted mb-4">search_off</span>
            <p class="text-secondary">没有找到匹配的笔记</p>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <footer class="site-footer py-8 px-6">
    <div class="max-w-7xl mx-auto text-center text-muted text-sm">
      © 2026 Global Frame. All rights reserved.
    </div>
  </footer>
</Layout>

<script>
  // Search functionality
  const searchInput = document.getElementById('note-search') as HTMLInputElement;
  const notesGrid = document.getElementById('notes-grid');
  const noResults = document.getElementById('no-results');
  const noteCards = document.querySelectorAll<HTMLElement>('.note-card');
  const tagButtons = document.querySelectorAll<HTMLElement>('.tag-filter');

  function setActiveTagByName(tagName?: string | null) {
    tagButtons.forEach((button) => {
      const isActive = !!tagName && button.dataset.tag === tagName;
      button.classList.toggle('bg-blue-500/20', isActive);
      button.classList.toggle('text-blue-400', isActive);
      button.classList.toggle('chip-neutral', !isActive);
    });
  }
  
  function filterNotes() {
    const query = searchInput?.value.toLowerCase() || '';
    const activeTag = document.querySelector('.tag-filter.bg-blue-500/20')?.getAttribute('data-tag');
    
    let visibleCount = 0;
    
    noteCards.forEach((el) => {
      const tags = JSON.parse(el.dataset.tags || '[]');
      const title = (el.dataset.title || '').toLowerCase();
      const description = (el.dataset.description || '').toLowerCase();
      
      const matchesSearch = !query || title.includes(query) || description.includes(query);
      const matchesTag = !activeTag || tags.includes(activeTag);
      
      if (matchesSearch && matchesTag) {
        el.style.display = '';
        el.style.animation = 'fadeSlideUp 0.3s ease-out';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });
    
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }
  
  searchInput?.addEventListener('input', filterNotes);
  
  // Tag filter
  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isActive = btn.classList.contains('bg-blue-500/20');
      
      setActiveTagByName(isActive ? null : btn.dataset.tag);
      filterNotes();
    });
  });

  // URL query hydration: supports ?q=keyword and ?tag=标签
  (function hydrateQueryState() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    const tag = params.get('tag');
    if (q && searchInput) {
      searchInput.value = q;
    }
    if (tag) {
      setActiveTagByName(tag);
    }
    filterNotes();
  })();
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
